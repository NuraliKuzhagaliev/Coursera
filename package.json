{
  "name": "coursera-local-queue",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/core.test.js && python -B -m unittest discover -s tests -p test_files.py",
    "test:chrome": "node tests/chrome.mjs",
    "build:commercial": "node platform/build.mjs",
    "start:api": "node platform/build/server.mjs",
    "dev:api": "tsx platform/server/index.ts",
    "build:admin": "node platform/admin-build.mjs",
    "start:admin": "next start platform/admin",
    "test:platform": "tsx --test platform/tests/*.test.ts",
    "typecheck:platform": "tsc -p platform/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.2.2",
    "@supabase/supabase-js": "2.119.0",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
