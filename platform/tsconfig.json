{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "chrome"],
    "noEmit": true
  },
  "include": ["server/**/*.ts", "extension/**/*.ts", "extension/**/*.tsx", "tests/**/*.ts"]
}
